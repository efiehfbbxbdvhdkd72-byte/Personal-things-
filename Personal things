task.spawn(function()
	while true do
		local rainbowColor = Color3.fromHSV(tick() % 5 / 5, 1, 1)
		local anyActive = espEnabled or espNpcEnabled or espPlayerNamesEnabled or espNpcNamesEnabled or espSelectedPlayersEnabled or espSelectedPlayersNamesEnabled or espSelectedNpcsEnabled or espSelectedNpcsNamesEnabled
		
		if not anyActive then
			espFolder:ClearAllChildren()
		else
			espFolder:ClearAllChildren()
			local targets = {}
			
			if espEnabled or espPlayerNamesEnabled then
				for _, otherPlayer in ipairs(Players:GetPlayers()) do
					if otherPlayer ~= player and otherPlayer.Character then
						table.insert(targets, {model = otherPlayer.Character, name = otherPlayer.DisplayName .. " (@" .. otherPlayer.Name .. ")", isPlayer = true})
					end
				end
			end
			
			if espSelectedPlayersEnabled or espSelectedPlayersNamesEnabled then
				for p, _ in pairs(selectedPlayers) do
					if p and p.Character then
						local alreadyAdded = false
						for _, t in ipairs(targets) do
							if t.model == p.Character then alreadyAdded = true break end
						end
						if not alreadyAdded then
							table.insert(targets, {model = p.Character, name = p.DisplayName .. " (@" .. p.Name .. ")", isPlayer = true})
						end
					end
				end
			end
			
			if espNpcEnabled or espNpcNamesEnabled then
				for _, descendant in ipairs(Workspace:GetDescendants()) do
					if descendant:IsA("Model") and descendant:FindFirstChildOfClass("Humanoid") then
						local isPlayerChar = false
						for _, p in ipairs(Players:GetPlayers()) do
							if p.Character == descendant then isPlayerChar = true break end
						end
						if not isPlayerChar then
							table.insert(targets, {model = descendant, name = descendant.Name, isPlayer = false})
						end
					end
				end
			end
			
			if espSelectedNpcsEnabled or espSelectedNpcsNamesEnabled then
				for npcModel, _ in pairs(selectedNpcs) do
					if npcModel and npcModel.Parent then
						local alreadyAdded = false
						for _, t in ipairs(targets) do
							if t.model == npcModel then alreadyAdded = true break end
						end
						if not alreadyAdded then
							table.insert(targets, {model = npcModel, name = npcModel.Name, isPlayer = false})
						end
					end
				end
			end
			
			for _, target in ipairs(targets) do
				local char = target.model
				local rootPart = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
				
				if rootPart then
					local myChar = player.Character
					local distance = 0
					if myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso")) then
						local myRoot = myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso")
						distance = math.floor((rootPart.Position - myRoot.Position).Magnitude)
					end
					
					local shouldHighlight = false
					if target.isPlayer then
						if espEnabled or (espSelectedPlayersEnabled and selectedPlayers[Players:GetPlayerFromCharacter(char)]) then
							shouldHighlight = true
						end
					else
						if espNpcEnabled or (espSelectedNpcsEnabled and selectedNpcs[char]) then
							shouldHighlight = true
						end
					end
					
					if shouldHighlight then
						local highlight = Instance.new("Highlight")
						highlight.Adornee = char
						highlight.FillColor = rainbowColor
						highlight.FillTransparency = 0.5
						highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
						highlight.OutlineTransparency = 0
						highlight.Parent = espFolder
					end
					
					local shouldShowText = false
					if target.isPlayer then
						if espPlayerNamesEnabled or (espSelectedPlayersNamesEnabled and selectedPlayers[Players:GetPlayerFromCharacter(char)]) then
							shouldShowText = true
						end
					else
						if espNpcNamesEnabled or (espSelectedNpcsNamesEnabled and selectedNpcs[char]) then
							shouldShowText = true
						end
					end
					
					if shouldShowText then
						local billboard = Instance.new("BillboardGui")
						billboard.Size = UDim2.new(0, 200, 0, 50)
						billboard.StudsOffset = Vector3.new(0, 3, 0)
						billboard.AlwaysOnTop = true
						
						local textLabel = Instance.new("TextLabel")
						textLabel.Size = UDim2.new(1, 0, 1, 0)
						textLabel.BackgroundTransparency = 1
						textLabel.Font = Enum.Font.GothamBold
						textLabel.TextSize = 13
						textLabel.TextColor3 = rainbowColor
						textLabel.TextStrokeTransparency = 0
						textLabel.Text = target.name .. "\n[" .. distance .. "m]"
						textLabel.Parent = billboard
						
						billboard.Adornee = rootPart
						billboard.Parent = espFolder
					end
				end
			end
		end
		
		task.wait(0.3)
	end
end)

local function updateSlider(inputPositionX)
	local absolutePosition = sliderBG.AbsolutePosition.X
	local absoluteSize = sliderBG.AbsoluteSize.X
	
	if absoluteSize <= 0 then return end
	
	local posRelative = math.clamp((inputPositionX - absolutePosition) / absoluteSize, 0, 1)
	local newSpeed = MIN_SPEED + (posRelative * (MAX_SPEED - MIN_SPEED))
	
	applySpeed(newSpeed, true)
end

