-- Lógica de Arrastre Manual para el Botón Flotante "P"
local isDraggingOpenBtn = false
local dragStartOpenBtn
local startPosOpenBtn
local hasMovedOpenBtn = false

openBtn.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDraggingOpenBtn = true
		hasMovedOpenBtn = false
		dragStartOpenBtn = input.Position
		startPosOpenBtn = openBtn.AbsolutePosition
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDraggingSlider = false
		isDraggingWindow = false
		isDraggingOpenBtn = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		if isDraggingSlider then
			updateSlider(input.Position.X)
		elseif isDraggingWindow then
			local delta = input.Position - dragStartWindow
			local newX = startPosWindow.X + delta.X
			local newY = startPosWindow.Y + delta.Y
			
			local viewportSize = workspace.CurrentCamera.ViewportSize
			local frameSize = mainFrame.AbsoluteSize
			
			newX = math.clamp(newX, 0, viewportSize.X - frameSize.X)
			newY = math.clamp(newY, 0, viewportSize.Y - frameSize.Y)
			
			mainFrame.Position = UDim2.new(0, newX, 0, newY)
		elseif isDraggingOpenBtn then
			local delta = input.Position - dragStartOpenBtn
			if delta.Magnitude > 5 then
				hasMovedOpenBtn = true
			end
			
			local newX = startPosOpenBtn.X + delta.X
			local newY = startPosOpenBtn.Y + delta.Y
			
			local viewportSize = workspace.CurrentCamera.ViewportSize
			local btnSize = openBtn.AbsoluteSize
			
			newX = math.clamp(newX, 0, viewportSize.X - btnSize.X)
			newY = math.clamp(newY, 0, viewportSize.Y - btnSize.Y)
			
			openBtn.Position = UDim2.new(0, newX, 0, newY)
		end
	end
end)

