-- Variable para controlar el sonido mientras escribes sin que se sature con cada carácter interno de Roblox
local lastTextLength = string.len(speedTextBox.Text)

speedTextBox:GetPropertyChangedSignal("Text"):Connect(function()
	local currentLength = string.len(speedTextBox.Text)
	if currentLength ~= lastTextLength then
		playSpeedSound()
		lastTextLength = currentLength
	end
	
	local num = tonumber(speedTextBox.Text)
	if num then
		currentSpeed = math.clamp(num, MIN_SPEED, MAX_SPEED)
		speedInfoLabel.Text = "Velocidad: " .. math.floor(currentSpeed)
		
		-- Actualizar posición visual del slider en tiempo real
		local posRelative = (currentSpeed - MIN_SPEED) / (MAX_SPEED - MIN_SPEED)
		sliderFill.Size = UDim2.new(posRelative, 0, 1, 0)
		sliderKnob.Position = UDim2.new(posRelative, -8, 0.5, -8)
	end
end)

