espFolder.Name = "ESPFanFolder"
espFolder.Parent = targetParent

local function playClick()
	clickSound:Play()
end

local function playSpeedSound()
	speedSound:Play()
end

local function getHumanoid()
	local character = player.Character
	if character then
		return character:FindFirstChildOfClass("Humanoid")
	end
	return nil
end

local function applySpeed(speed, updateBox)
	currentSpeed = math.clamp(speed, MIN_SPEED, MAX_SPEED)
	speedInfoLabel.Text = "Velocidad: " .. math.floor(currentSpeed)
	
	if updateBox then
		speedTextBox.Text = tostring(math.floor(currentSpeed))
	end
	
	-- Actualizar posición visual del slider automáticamente
	local posRelative = (currentSpeed - MIN_SPEED) / (MAX_SPEED - MIN_SPEED)
	sliderFill.Size = UDim2.new(posRelative, 0, 1, 0)
	sliderKnob.Position = UDim2.new(posRelative, -8, 0.5, -8)
end

RunService.Heartbeat:Connect(function()
	local humanoid = getHumanoid()
	if humanoid then
		if humanoid.WalkSpeed ~= currentSpeed then
			humanoid.WalkSpeed = currentSpeed
		end
	end
end)

UserInputService.JumpRequest:Connect(function()
	if infiniteJumpEnabled then
		local humanoid = getHumanoid()
		if humanoid then
			humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end
end)

